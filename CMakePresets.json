{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "develop",
      "hidden": true
    },
    {
      "name": "ninja",
      "hidden": true,
      "generator": "Ninja"
    },
    {
      "name": "ninja-develop",
      "inherits": [
        "develop",
        "ninja"
      ],
      "displayName": "Build pyGinkgo bindings",
      "description": "Build pyGinkgo bindings",
      "binaryDir": "${sourceDir}/build/Develop"
    },


    {
      "name": "msvc",
      "hidden": true,
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "msvc-develop",
      "inherits": [
        "develop",
        "msvc"
      ],
      "displayName": "Build pyGinkgo bindings for Windows",
      "description": "Build pyGinkgo bindings for Windows",
      "binaryDir": "${sourceDir}/build/DevelopWindows"
    },
    {
      "name": "wsl_makefiles",
      "hidden": true,
      "generator": "Unix Makefiles"
    },
    {
      "name": "wsl_makefiles-develop",
      "inherits": [
        "develop",
        "wsl_makefiles"
      ],
      "displayName": "Build pyGinkgo bindings for Windows WSL",
      "description": "Build pyGinkgo bindings for Windows WSL",
      "binaryDir": "${sourceDir}/build/DevelopWSL",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GINKGO_BUILD_CUDA": "ON",
        "GINKGO_BUILD_HIP": "OFF",
        "GINKGO_BUILD_MPI": "OFF",
        "GINKGO_DPCPP_SINGLE_MODE": "OFF"
      }
    },
    {
      "name": "wsl_dpcpp_makefiles-develop",
      "inherits": [
        "develop",
        "wsl_makefiles"
      ],
      "displayName": "Build pyGinkgo bindings for DPCPP on Windows WSL",
      "description": "Build pyGinkgo bindings for DPCPP on Windows WSL",
      "binaryDir": "${sourceDir}/build/DevelopWSL_DPCPP",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "/opt/intel/oneapi/compiler/2024.2/bin/icpx",
        "GINKGO_BUILD_CUDA": "OFF",
        "GINKGO_BUILD_HIP": "OFF",
        "GINKGO_BUILD_MPI": "OFF",
        "GINKGO_DPCPP_SINGLE_MODE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-develop",
      "displayName": "Build for CPUs only with unit tests enabled",
      "configurePreset": "ninja-develop",
      "configuration": "ninja-develop"
    },


    {
      "name": "msvc-develop",
      "displayName": "Build for CPUs only with unit tests enabled for Windows",
      "configurePreset": "msvc-develop",
      "configuration": "RelWithDebInfo",
      "targets": [
        "ALL_BUILD", "pyGinkgo", "debugging_target"
      ]
    },
    {
      "name": "wsl_makefiles-develop-debug",
      "displayName": "Build for CPUs only with unit tests enabled for WSL",
      "configurePreset": "wsl_makefiles-develop",
      "targets": [
        "all", "pyGinkgo", "debugging_target"
      ],
      "jobs": 10
    },
    {
      "name": "wsl_dpcpp_makefiles-develop-debug",
      "displayName": "Build for DPCPP with unit tests enabled for WSL",
      "configurePreset": "wsl_dpcpp_makefiles-develop",
      "inherits": ["wsl_makefiles-develop-debug"]
    }
   ]
}
